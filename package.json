{
  "name": "seo-sitemap-discovery",
  "version": "1.1.0",
  "description": "A high-performance SEO utility for automated sitemap discovery and URL-based keyword extraction.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run build:assets && concurrently --kill-others --names app,css,client \"node --watch --import tsx src/index.ts\" \"npm:watch:css\" \"npm:watch:client\"",
    "build": "tsc -p tsconfig.json && npm run build:assets",
    "typecheck": "tsc --noEmit",
    "build:assets": "npm run build:css && npm run build:client",
    "build:css": "tailwindcss -i src/web/styles.css -o public/assets/site.css --minify",
    "build:client": "esbuild src/web/tool.ts --bundle --format=esm --minify --outfile=public/assets/tool.js",
    "watch:css": "npm run build:css -- --watch=always",
    "watch:client": "npm run build:client -- --watch=forever",
    "start": "node dist/index.js",
    "format": "prettier . --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "sitemap",
    "keyword",
    "extractor",
    "seo"
  ],
  "author": "reynaldiarya",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "axios": "^1.21.1",
    "content-type": "^3.1.1",
    "dotenv": "^18.0.10",
    "hono": "^4.13.19",
    "iconv-lite": "^0.7.3",
    "winston": "^3.19.0",
    "xml2js": "^0.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/xml2js": "^0.4.14",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
