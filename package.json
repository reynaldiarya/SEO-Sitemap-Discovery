{
  "name": "sitemap-keyword-extractor",
  "version": "1.0.0",
  "description": "A high-performance SEO utility for automated sitemap discovery and URL-based keyword extraction.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "format": "prettier . --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "sitemap",
    "keyword",
    "extractor",
    "seo"
  ],
  "author": "reynaldiarya",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.16.0",
    "express": "^5.2.1",
    "winston": "^3.19.0",
    "xml2js": "^0.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/xml2js": "^0.4.14",
    "dotenv": "^17.4.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
